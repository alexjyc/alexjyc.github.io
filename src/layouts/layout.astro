---
import "../css/main.css";
import GradientBlob from "../components/GradientBlob.astro";

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f5f5f7" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content="Alex Jeon" />
    <meta name="description" content="AI engineer and researcher. Columbia University, Stanford AI Lab, Microsoft Research." />
  </head>
  <body>
    <GradientBlob />
    <main class="container">
      <slot />
    </main>
  </body>
</html>
