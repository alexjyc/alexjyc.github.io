---
import "../css/main.css";

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content="Alex Jeon" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="antialiased">
    <div 
      class:list={[
        "grid grid-rows-[max-content_1fr] sm:grid-rows-none sm:grid-cols-[max-content_minmax(0,540px)] sm:gap-x-22",
        "sm:max-w-max sm:ml-8 min-h-dvh",
      ]}
    >
      <nav class="h-max max-sm:flex max-sm:items-end max-sm:gap-x-6 sm:sticky sm:top-0 sm:pt-16 pl-6 max-sm:pl-11 max-sm:pr-11 max-sm:pt-12">
        <ul class="sm:mt-5 space-x-2 sm:space-x-0">
          <li class:list={["max-sm:inline-block"]}><a href="/" class="nav-link">About</a></li>
          <li class:list={["max-sm:inline-block"]}><a href="/projects" class="nav-link">Projects</a></li>
          <li class:list={["max-sm:inline-block"]}><a href="https://www.linkedin.com/in/alexjyc/" class="external-link">Linkedin</a></li>
          <li class:list={["max-sm:inline-block"]}><a href="mailto:alexjyc3@gmail.com" class="external-link">Email</a></li>
        </ul>
      </nav>
      <main class="max-sm:pt-6 sm:pt-16 flex flex-col max-sm:pl-10 max-sm:pr-11">
        <slot />
      </main>
    </div>
  </body>
</html>