---
// 3D Polyhedron "Crystal Gyroscope" - Jony Ive Design
// Replaces Dandelion with a rotating Icosahedron driven by scroll
---

<canvas id="gyro-canvas"></canvas>

<script>
  interface Point3D {
    x: number;
    y: number;
    z: number;
  }

  interface Edge {
    start: number;
    end: number;
  }

  // "Jony Ive" Palette - Phantom Glass & Refracted Light
  const colors = {
    // Edges: Cool Steel Grey (Space Grey hardware tone), low opacity for "etched glass" feel
    edges: 'rgba(142, 144, 157, 0.25)', 
    nodes: [
      'rgba(10, 132, 255, 0.7)',    // Sapphire (Refracted)
      'rgba(48, 209, 88, 0.7)',     // Mint (Refracted)
      'rgba(255, 159, 10, 0.7)',    // Tangerine (Refracted)
      'rgba(191, 90, 242, 0.7)',    // Lavender (Refracted)
      'rgba(100, 210, 255, 0.7)',   // Cyan (Refracted)
      'rgba(255, 69, 58, 0.7)'      // Coral (Refracted)
    ]
  };

  class PolyhedronCanvas {
    private canvas: HTMLCanvasElement;
    private ctx: CanvasRenderingContext2D;
    
    private width: number = 0;
    private height: number = 0;
    private dpr: number = 1;

    // 3D Properties
    private vertices: Point3D[] = [];
    private edges: Edge[] = [];
    private rotation: Point3D = { x: 0, y: 0, z: 0 };
    private targetRotation: Point3D = { x: 0, y: 0, z: 0 };
    private scale: number = 120; // Small Jewel on side

    private lastScrollY: number = 0;
    private time: number = 0;

    constructor(canvas: HTMLCanvasElement) {
      this.canvas = canvas;
      const ctx = canvas.getContext('2d');
      if (!ctx) throw new Error('No 2D context');
      this.ctx = ctx;

      this.initIcosahedron();
      this.resize();

      window.addEventListener('resize', this.resize.bind(this));
      window.addEventListener('scroll', this.onScroll.bind(this), { passive: true });
      
      this.animate();
    }

    private initIcosahedron(): void {
      // Golden Ratio
      const t = (1.0 + Math.sqrt(5.0)) / 2.0;

      // Vertical Rect
      this.addVertex(-1, t, 0);
      this.addVertex(1, t, 0);
      this.addVertex(-1, -t, 0);
      this.addVertex(1, -t, 0);

      // Horizontal Rect
      this.addVertex(0, -1, t);
      this.addVertex(0, 1, t);
      this.addVertex(0, -1, -t);
      this.addVertex(0, 1, -t);

      // Cross Rect
      this.addVertex(t, 0, -1);
      this.addVertex(t, 0, 1);
      this.addVertex(-t, 0, -1);
      this.addVertex(-t, 0, 1);

      // Define Edges (Icosahedron needs specific connections, using simple neighbor check for visual style)
      // Actually, for a clean wireframe, we should calculate distance.
      // In an icosahedron, edges only connect vertices of distance 2.
      for (let i = 0; i < this.vertices.length; i++) {
        for (let j = i + 1; j < this.vertices.length; j++) {
            const d = this.dist(this.vertices[i], this.vertices[j]);
            // Distance is 2 in this unit cube construction
            if (d > 1.9 && d < 2.1) {
                this.edges.push({ start: i, end: j });
            }
        }
      }
    }

    private addVertex(x: number, y: number, z: number): void {
        this.vertices.push({ x, y, z });
    }

    private dist(p1: Point3D, p2: Point3D): number {
        return Math.sqrt(Math.pow(p1.x - p2.x, 2) + Math.pow(p1.y - p2.y, 2) + Math.pow(p1.z - p2.z, 2));
    }

    private resize(): void {
      this.dpr = Math.min(window.devicePixelRatio, 2);
      this.width = window.innerWidth;
      this.height = window.innerHeight;

      this.canvas.width = this.width * this.dpr;
      this.canvas.height = this.height * this.dpr;
      this.canvas.style.width = `${this.width}px`;
      this.canvas.style.height = `${this.height}px`;

      this.ctx.scale(this.dpr, this.dpr);
    }

    private onScroll(): void {
      const currentScrollY = window.scrollY;
      const delta = currentScrollY - this.lastScrollY;
      this.lastScrollY = currentScrollY;

      // GYRO LOGIC: Scroll drives rotation speed and tilt
      // Spin primarily on Y, tilt on X based on speed
      this.targetRotation.y += delta * 0.005; 
      this.targetRotation.x += delta * 0.002;
    }

    private rotatePoint(p: Point3D, rot: Point3D): Point3D {
        // Simple Euler rotation (X, Y, Z)
        let x = p.x, y = p.y, z = p.z;

        // Rotate X
        let cos = Math.cos(rot.x), sin = Math.sin(rot.x);
        let ny = y * cos - z * sin;
        let nz = y * sin + z * cos;
        y = ny; z = nz;

        // Rotate Y
        cos = Math.cos(rot.y); sin = Math.sin(rot.y);
        let nx = x * cos - z * sin;
        nz = x * sin + z * cos;
        x = nx; z = nz;

        // Rotate Z
        cos = Math.cos(rot.z); sin = Math.sin(rot.z);
        nx = x * cos - y * sin;
        ny = x * sin + y * cos;
        x = nx; y = ny;

        return { x, y, z };
    }

    private project(p: Point3D): { x: number, y: number, scale: number } {
        // Perspective Projection
        const fov = 1000;
        const dist = fov / (fov + p.z * this.scale); // Z Scale factor
        
        // Jony Ive Corner: Bottom-Right Precision Anchor
        // Acts like a signature/watermark of quality
        const centerX = this.width * 0.9;
        const centerY = this.height * 0.85;

        return {
            x: centerX + p.x * this.scale * dist,
            y: centerY + p.y * this.scale * dist,
            scale: dist
        };
    }

    private update(): void {
      this.time += 0.016;

      // Inertia: Smoothly interpolate current rotation to target
      // Also add a constant slow "idle" spin
      this.targetRotation.y += 0.002; // Idle spin
      
      this.rotation.x += (this.targetRotation.x - this.rotation.x) * 0.05;
      this.rotation.y += (this.targetRotation.y - this.rotation.y) * 0.05;
      this.rotation.z += (this.targetRotation.z - this.rotation.z) * 0.05;
      
      // Decay target tilt back to 0
      this.targetRotation.x *= 0.95;
    }

    private draw(): void {
      this.ctx.clearRect(0, 0, this.width, this.height);
      
      // Transform all vertices first
      const projectedVertices = this.vertices.map(v => {
          const rotated = this.rotatePoint(v, this.rotation);
          return { ...this.project(rotated), z: rotated.z }; // Keep z for sorting if needed
      });

      // Draw Edges (Wireframe) - Delicate but visible
      this.ctx.strokeStyle = colors.edges;
      this.ctx.lineWidth = 0.8;
      this.ctx.lineCap = 'round';
      
      this.edges.forEach(edge => {
          const start = projectedVertices[edge.start];
          const end = projectedVertices[edge.end];
          
          // Depth fading (fog)
          const zAvg = (this.vertices[edge.start].z + this.vertices[edge.end].z) / 2; // Rough Z
          // We can use the scale factor as a proxy for depth/opacity
          const opacity = Math.min(1, Math.max(0.1, (start.scale + end.scale)/2 * 0.6));
          
          this.ctx.beginPath();
          this.ctx.moveTo(start.x, start.y);
          this.ctx.lineTo(end.x, end.y);
          this.ctx.strokeStyle = `rgba(140, 145, 155, ${opacity})`;
          this.ctx.stroke();
      });

      // Draw Vertices (Jony Ive Nodes)
      // LUXURY GLOW: Manual approach for performance
      projectedVertices.forEach((p, i) => {
          // Color based on index
          const color = colors.nodes[i % colors.nodes.length];
          
          const size = 3 * p.scale;
           
          // 1. Glow (Translucent larger circle)
          this.ctx.beginPath();
          this.ctx.arc(p.x, p.y, size * 3, 0, Math.PI * 2);
          this.ctx.fillStyle = color.replace('0.9)', '0.2)');
          this.ctx.fill();

          // 2. Core (Solid)
          this.ctx.beginPath();
          this.ctx.arc(p.x, p.y, size, 0, Math.PI * 2);
          this.ctx.fillStyle = color;
          this.ctx.fill();
      });
    }

    private animate = () => {
      this.update();
      this.draw();
      requestAnimationFrame(this.animate);
    }
  }

  const el = document.getElementById('gyro-canvas');
  if (el) new PolyhedronCanvas(el as HTMLCanvasElement);
</script>

<style>
  #gyro-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
</style>
